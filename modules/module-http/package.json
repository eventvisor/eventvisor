{
  "name": "@eventvisor/module-http",
  "version": "0.26.0",
  "description": "Reliable batching HTTP transport module for Eventvisor",
  "main": "cjs/index.js",
  "module": "esm/index.js",
  "files": [
    "cjs",
    "esm",
    "node-esm"
  ],
  "types": "cjs/index.d.ts",
  "exports": {
    ".": {
      "types": "./cjs/index.d.ts",
      "require": "./cjs/index.js",
      "import": "./node-esm/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "transpile": "rimraf cjs esm node-esm && tsc --project tsconfig.cjs.json && tsc --project tsconfig.esm.json && tsc --project tsconfig.node-esm.json && node ../../scripts/create-node-esm-package.mjs",
    "build": "npm run transpile",
    "typecheck": "tsc --noEmit --project tsconfig.typecheck.json",
    "test:jest": "jest --config jest.config.js --verbose --coverage",
    "test": "npm run test:jest",
    "lint": "eslint src"
  },
  "author": {
    "name": "Fahad Heylaal",
    "url": "https://fahad19.com"
  },
  "keywords": [],
  "homepage": "https://eventvisor.org",
  "repository": {
    "type": "git",
    "url": "https://github.com/eventvisor/eventvisor.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "bugs": {
    "url": "https://github.com/eventvisor/eventvisor/issues"
  },
  "license": "MIT",
  "peerDependencies": {
    "@eventvisor/sdk": ">=0.26.0"
  },
  "devDependencies": {
    "@eventvisor/sdk": "0.26.0"
  }
}
