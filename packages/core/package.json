{
  "name": "@eventvisor/core",
  "version": "1.0.0",
  "description": "Project building, testing, linting, and Catalog tools for Eventvisor",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib"
  ],
  "scripts": {
    "transpile": "rimraf lib && tsc --project tsconfig.cjs.json",
    "dist": "echo 'Nothing to dist here'",
    "build": "npm run transpile",
    "typecheck": "tsc --project tsconfig.typecheck.json",
    "test": "jest --config jest.config.js --verbose --coverage",
    "lint": "eslint src"
  },
  "author": {
    "name": "Fahad Heylaal",
    "url": "https://fahad19.com"
  },
  "homepage": "https://eventvisor.org",
  "keywords": [
    "analytics",
    "eventvisor",
    "governance",
    "tracking-plan"
  ],
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/eventvisor/eventvisor.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "bugs": {
    "url": "https://github.com/eventvisor/eventvisor/issues"
  },
  "license": "MIT",
  "dependencies": {
    "@eventvisor/catalog": "1.0.0",
    "@eventvisor/parsers": "1.0.0",
    "@eventvisor/sdk": "1.0.0",
    "@eventvisor/types": "1.0.0",
    "axios": "^1.19.0",
    "tar": "^7.5.22",
    "yargs": "^17.7.2",
    "zod": "^4.0.17"
  }
}
