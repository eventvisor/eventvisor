{
  "name": "@eventvisor/sdk",
  "version": "1.0.0",
  "description": "Event governance SDK for browsers, Node.js, and React Native",
  "main": "cjs/index.js",
  "module": "esm/index.js",
  "files": [
    "cjs",
    "esm",
    "node-esm"
  ],
  "types": "cjs/index.d.ts",
  "exports": {
    ".": {
      "types": "./cjs/index.d.ts",
      "require": "./cjs/index.js",
      "import": "./node-esm/index.js"
    },
    "./portable": {
      "types": "./cjs/portable.d.ts",
      "require": "./cjs/portable.js",
      "import": "./node-esm/portable.js"
    },
    "./validator": {
      "types": "./cjs/validator.d.ts",
      "require": "./cjs/validator.js",
      "import": "./node-esm/validator.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "npm run transpile",
    "typecheck": "tsc --project tsconfig.typecheck.json",
    "test": "jest --config jest.config.js --verbose --coverage",
    "test:no-coverage": "jest --config jest.config.js --verbose",
    "lint": "eslint src",
    "transpile": "rimraf cjs esm node-esm && tsc --project tsconfig.cjs.json && tsc --project tsconfig.esm.json && tsc --project tsconfig.node-esm.json && node ../../scripts/create-node-esm-package.mjs"
  },
  "author": {
    "name": "Fahad Heylaal",
    "url": "https://fahad19.com"
  },
  "homepage": "https://eventvisor.org",
  "keywords": [
    "analytics",
    "eventvisor",
    "governance",
    "tracking"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/eventvisor/eventvisor.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "bugs": {
    "url": "https://github.com/eventvisor/eventvisor/issues"
  },
  "license": "MIT",
  "dependencies": {
    "@eventvisor/types": "1.0.0"
  }
}
