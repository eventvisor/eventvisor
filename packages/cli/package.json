{
  "name": "@eventvisor/cli",
  "version": "1.0.0",
  "description": "Command line tools for Eventvisor projects",
  "main": "bin.js",
  "types": "lib/index.d.ts",
  "files": [
    "bin.js",
    "lib"
  ],
  "bin": {
    "eventvisor": "./bin.js"
  },
  "scripts": {
    "transpile": "rimraf lib && tsc --project tsconfig.cjs.json",
    "dist": "echo 'Nothing to dist here'",
    "build": "npm run transpile",
    "typecheck": "tsc --project tsconfig.typecheck.json",
    "test": "jest --config jest.config.js --runInBand",
    "lint": "eslint src"
  },
  "homepage": "https://eventvisor.org",
  "keywords": [
    "analytics",
    "cli",
    "eventvisor",
    "governance"
  ],
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/eventvisor/eventvisor.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "bugs": {
    "url": "https://github.com/eventvisor/eventvisor/issues"
  },
  "author": {
    "name": "Fahad Heylaal",
    "url": "https://fahad19.com"
  },
  "license": "MIT",
  "dependencies": {
    "@eventvisor/core": "1.0.0"
  }
}
