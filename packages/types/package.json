{
  "name": "@eventvisor/types",
  "version": "1.0.0",
  "description": "Shared TypeScript contracts for Eventvisor",
  "main": "src/index.js",
  "module": "src/index.js",
  "types": "src/index.d.ts",
  "files": [
    "src/index.d.ts",
    "src/index.js"
  ],
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "require": "./src/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "transpile": "echo 'Nothing to transpile'",
    "dist": "echo 'Nothing to dist'",
    "build": "tsc --project tsconfig.json --noEmit",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "test": "npm run typecheck",
    "lint": "eslint src"
  },
  "author": {
    "name": "Fahad Heylaal",
    "url": "https://fahad19.com"
  },
  "homepage": "https://eventvisor.org",
  "keywords": [
    "analytics",
    "eventvisor",
    "typescript",
    "types"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/eventvisor/eventvisor.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "bugs": {
    "url": "https://github.com/eventvisor/eventvisor/issues"
  },
  "license": "MIT"
}
