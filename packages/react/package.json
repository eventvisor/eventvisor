{
  "name": "@eventvisor/react",
  "version": "1.0.0",
  "description": "React bindings for the Eventvisor JavaScript SDK",
  "main": "cjs/index.js",
  "module": "esm/index.js",
  "types": "cjs/index.d.ts",
  "files": [
    "cjs",
    "esm",
    "node-esm"
  ],
  "exports": {
    ".": {
      "types": "./cjs/index.d.ts",
      "require": "./cjs/index.js",
      "import": "./node-esm/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "transpile": "rimraf cjs esm node-esm && tsc --project tsconfig.cjs.json && tsc --project tsconfig.esm.json && tsc --project tsconfig.node-esm.json && node ../../scripts/create-node-esm-package.mjs",
    "build": "npm run transpile",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "test": "jest --config jest.config.js",
    "lint": "eslint src"
  },
  "author": {
    "name": "Fahad Heylaal",
    "url": "https://fahad19.com"
  },
  "homepage": "https://eventvisor.org",
  "keywords": [
    "analytics",
    "eventvisor",
    "react",
    "tracking"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/eventvisor/eventvisor.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "bugs": {
    "url": "https://github.com/eventvisor/eventvisor/issues"
  },
  "dependencies": {
    "@eventvisor/sdk": "1.0.0",
    "@eventvisor/types": "1.0.0"
  },
  "peerDependencies": {
    "react": ">=16.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "jest-environment-jsdom": "^30.4.1",
    "react": "^19.1.1"
  },
  "license": "MIT"
}
