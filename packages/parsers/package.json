{
  "name": "@eventvisor/parsers",
  "version": "0.26.0",
  "description": "Source file parsers for Eventvisor projects",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib"
  ],
  "scripts": {
    "transpile": "rimraf lib && tsc --project tsconfig.cjs.json",
    "dist": "echo 'Nothing to dist here'",
    "build": "npm run transpile",
    "test": "jest --config jest.config.js --verbose",
    "typecheck": "tsc --noEmit --skipLibCheck -p tsconfig.typecheck.json",
    "lint": "eslint src"
  },
  "author": {
    "name": "Fahad Heylaal",
    "url": "https://fahad19.com"
  },
  "homepage": "https://eventvisor.org",
  "keywords": [
    "analytics",
    "eventvisor",
    "json",
    "yaml"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/eventvisor/eventvisor.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "bugs": {
    "url": "https://github.com/eventvisor/eventvisor/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  }
}
