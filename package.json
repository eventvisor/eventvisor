{
  "name": "eventvisor",
  "private": true,
  "version": "0.0.1",
  "description": "Fine grained control over analytics events",
  "workspaces": [
    "packages/*",
    "modules/*",
    "projects/*",
    "examples/*"
  ],
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "lerna run build",
    "test": "lerna run test",
    "test:browser": "npm run test:browser:catalog && npm run test:browser:examples",
    "test:browser:catalog": "npm run test:browser --workspace @eventvisor/catalog",
    "test:browser:examples": "playwright test --config examples/playwright.config.ts",
    "lint": "prettier examples/ packages/ modules/ projects/ --check && eslint . && lerna run lint",
    "typecheck": "lerna run typecheck",
    "bundle-sizes": "node scripts/bundle-sizes.mjs",
    "licenses:check": "node scripts/check-licenses.mjs",
    "dependency-check": "npm run licenses:check && npm audit --omit=dev --audit-level=high",
    "release-check": "node scripts/release-check.mjs",
    "check": "npm run clean && npm run build && npm test && npm run lint && npm run typecheck && npm run test:browser && npm run dependency-check && npm run release-check"
  },
  "engines": {
    "node": ">=24"
  },
  "author": {
    "name": "Fahad Heylaal",
    "url": "https://fahad19.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@swc/core": "^1.15.43",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.1",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.7.0",
    "globals": "^17.7.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "lerna": "^10.0.0",
    "prettier": "^3.9.5",
    "rimraf": "^6.1.3",
    "terser": "^5.49.0",
    "typescript": "^6.0.3",
    "vite": "^8.1.5"
  },
  "overrides": {
    "yaml": "^2.9.0",
    "tar": "^7.5.22",
    "axios": "^1.19.0"
  }
}
